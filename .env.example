# CodePulse server configuration — copy to `.env` (which is gitignored) and fill in.
# Real process-environment values always win over this file; keys are read from
# the SERVER environment only, never from a request payload.

# ── LLM providers (pick the one you want reviews to use) ─────────────────────
# Zyloo (OpenAI-compatible; Gemini 3 Pro preview). Provider id: "zyloo".
ZYLOO_API_KEY=sk-zy-...

# Anthropic Claude. Provider id: "anthropic".
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI. Provider id: "openai".
# OPENAI_API_KEY=sk-...

# Google Gemini. Provider id: "google".
# GEMINI_API_KEY=...

# ── Access control (optional) ────────────────────────────────────────────────
# Static service token for CI/webhooks/scripts (Bearer token = admin).
# CODEPULSE_TOKEN=...
# Bootstrap a first admin account non-interactively.
# CODEPULSE_ADMIN_USER=admin
# CODEPULSE_ADMIN_PASSWORD=change-me-please
# Webhook HMAC secret.
# CODEPULSE_WEBHOOK_SECRET=...

# ── Transport (optional TLS) ─────────────────────────────────────────────────
# CODEPULSE_TLS_CERT=/path/to/fullchain.pem
# CODEPULSE_TLS_KEY=/path/to/privkey.pem
